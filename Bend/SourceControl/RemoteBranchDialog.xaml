<Window x:Class="Bend.SourceControl.RemoteBranchDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Checkout Remote Branch" Width="520" SizeToContent="Height" ResizeMode="NoResize"
 WindowStyle="None" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 AllowsTransparency="True" Background="Transparent" KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style x:Key="DialogButton" TargetType="Button">
   <Setter Property="Width" Value="82"/><Setter Property="Height" Value="24"/>
   <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="FontFamily" Value="Segoe UI"/>
  </Style>
 </Window.Resources>
 <Border>
  <Border.BitmapEffect>
   <DropShadowBitmapEffect Color="Black" Direction="320" ShadowDepth="5" Softness="1" Opacity="0.5"/>
  </Border.BitmapEffect>
  <Grid Margin="20" Background="{DynamicResource BackgroundBrush}">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid Margin="0,20,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource LogoBackgroundBrush}"/>
    <TextBlock Grid.Column="1" Text="CHECKOUT REMOTE BRANCH" Margin="20,0,10,0" FontSize="16"
               FontWeight="ExtraLight" FontFamily="Segoe UI" VerticalAlignment="Center"
               Foreground="{DynamicResource ForegroundBrush}"/>
   </Grid>
   <TextBlock Grid.Row="1" Margin="30,0,10,7" Text="Enter a remote branch, for example origin/feature/name."
              FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
   <TextBox x:Name="BranchBox" Grid.Row="2" Margin="30,0,10,0" Height="30" Padding="7,4"
            FontFamily="Segoe UI" FontSize="13" Text="origin/"
            Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource ShellChromeBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}" CaretBrush="{DynamicResource ForegroundBrush}"
            TextChanged="BranchBox_TextChanged"/>
   <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,25,12">
    <Button x:Name="CheckoutButton" Content="CHECKOUT" Width="92" Style="{StaticResource DialogButton}"
            IsDefault="True" Click="Checkout_Click"/>
    <Button Content="CANCEL" Style="{StaticResource DialogButton}" IsCancel="True" Margin="10,0,0,0"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
