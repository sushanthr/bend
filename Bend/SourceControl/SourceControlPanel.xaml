<UserControl x:Class="Bend.SourceControl.SourceControlPanel" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Bend.Controls"
 Background="{DynamicResource ShellChromeBrush}" Foreground="{DynamicResource ForegroundBrush}">
 <UserControl.Resources>
  <Style x:Key="Codicon" TargetType="TextBlock"><Setter Property="FontFamily" Value="/Bend;component/Fonts/#codicon"/><Setter Property="FontSize" Value="15"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="ScmIconButton" TargetType="Button"><Setter Property="Width" Value="26"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TreeView"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/></Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
   <Setter Property="Background" Value="{DynamicResource ShellChromeBrush}"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource MenuSelectedBackgroundBrush}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource MenuSelectedBackgroundBrush}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Segment" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="3"/></Grid.RowDefinitions>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,5"/>
     <Border x:Name="Indicator" Grid.Row="1" Height="3" Background="Transparent"/>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource LogoBackgroundBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FlatBranchPicker" TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}"/><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><ToggleButton x:Name="DropDownToggle" Focusable="True" FocusVisualStyle="{x:Null}" ClickMode="Press" HorizontalContentAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
      <ToggleButton.Template>
       <ControlTemplate TargetType="ToggleButton">
        <Border x:Name="FocusBorder" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
         <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource LogoBackgroundBrush}"/><Setter TargetName="FocusBorder" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </ToggleButton.Template>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="&#xEA68;" FontFamily="/Bend;component/Fonts/#codicon" FontSize="15" Foreground="{DynamicResource LogoBackgroundBrush}" Margin="8,0,7,0" VerticalAlignment="Center"/>
       <ContentPresenter Grid.Column="1" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
       <Path Grid.Column="2" Data="M0,0 L8,0 L4,5 Z" Fill="{DynamicResource ShellMutedBrush}" Margin="8,0" VerticalAlignment="Center"/>
      </Grid>
     </ToggleButton>
     <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}" Background="{DynamicResource ShellChromeBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" Padding="2"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="OverridesDefaultStyle" Value="True"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Width" Value="8"/>
   <Setter Property="MinWidth" Value="8"/>
  <Setter Property="Margin" Value="-8,0,0,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent" ClipToBounds="False">
       <controls:MinimumThumbTrack x:Name="PART_Track" IsDirectionReversed="True" ClipToBounds="False">
        <Track.DecreaseRepeatButton>
         <RepeatButton IsTabStop="False" Focusable="False" Background="Transparent" BorderThickness="0" Command="ScrollBar.PageUpCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
           <Thumb MinHeight="40" ClipToBounds="False" Background="{DynamicResource ShellMutedBrush}">
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb">
            <Border Width="6" MinHeight="40" HorizontalAlignment="Center" Background="{DynamicResource ShellMutedBrush}" CornerRadius="3"/>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton IsTabStop="False" Focusable="False" Background="Transparent" BorderThickness="0" Command="ScrollBar.PageDownCommand"/>
        </Track.IncreaseRepeatButton>
       </controls:MinimumThumbTrack>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="Orientation" Value="Horizontal">
     <Setter Property="Height" Value="8"/>
     <Setter Property="MinHeight" Value="8"/>
     <Setter Property="Width" Value="Auto"/>
     <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Margin" Value="0,-8,0,0"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent" ClipToBounds="False">
         <controls:MinimumThumbTrack x:Name="PART_Track" ClipToBounds="False">
          <Track.DecreaseRepeatButton>
           <RepeatButton IsTabStop="False" Focusable="False" Background="Transparent" BorderThickness="0" Command="ScrollBar.PageLeftCommand"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
              <Thumb Width="40" MinWidth="40" ClipToBounds="False" Background="{DynamicResource ShellMutedBrush}">
            <Thumb.Template>
             <ControlTemplate TargetType="Thumb">
                <Border Width="40" Height="6" MinWidth="40" VerticalAlignment="Center" Background="{DynamicResource ShellMutedBrush}" CornerRadius="3"/>
             </ControlTemplate>
            </Thumb.Template>
           </Thumb>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
           <RepeatButton IsTabStop="False" Focusable="False" Background="Transparent" BorderThickness="0" Command="ScrollBar.PageRightCommand"/>
          </Track.IncreaseRepeatButton>
         </controls:MinimumThumbTrack>
        </Grid>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Trigger>
   </Style.Triggers>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type local:ChangeGroup}" ItemsSource="{Binding Nodes}" xmlns:local="clr-namespace:Bend.SourceControl">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Tag="{Binding}" Visibility="{Binding StageAllVisibility}" Style="{StaticResource ScmIconButton}" Width="24" Height="22" Margin="5,0,0,0" ToolTip="Stage all changes" Click="StageAll_Click">
     <TextBlock Style="{StaticResource Codicon}" FontSize="13" Text="&#xEA60;"/>
    </Button>
   </Grid>
  </HierarchicalDataTemplate>
  <HierarchicalDataTemplate DataType="{x:Type local:ScmTreeNode}" ItemsSource="{Binding Children}" xmlns:local="clr-namespace:Bend.SourceControl"><Grid Height="25" ToolTip="{Binding FullPath}"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource Codicon}" Text="{Binding IconGlyph}" Opacity=".82"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding StatusText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SourceControlStatusBrush}"/><Button Grid.Column="3" Tag="{Binding Change}" Visibility="{Binding ActionVisibility}" Style="{StaticResource ScmIconButton}" ToolTip="{Binding ActionToolTip}" Click="StageToggle_Click"><TextBlock Style="{StaticResource Codicon}" FontSize="13" Text="{Binding ActionGlyph}"/></Button></Grid></HierarchicalDataTemplate>
  <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><EventSetter Event="Expanded" Handler="Folder_Expanded"/></Style>
 </UserControl.Resources>
 <Grid Margin="10,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <RadioButton x:Name="ChangesMode" GroupName="TopMode" Style="{StaticResource Segment}" IsChecked="True" Checked="TopMode_Checked"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Codicon}" FontSize="13" Text="&#xEA60;" Margin="0,0,6,0"/><TextBlock Text="Changes"/></StackPanel></RadioButton>
    <RadioButton x:Name="CommitMode" Grid.Column="1" GroupName="TopMode" Style="{StaticResource Segment}" Checked="TopMode_Checked"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Codicon}" Text="&#xEA82;" Margin="0,0,6,0"/><TextBlock Text="Details"/></StackPanel></RadioButton>
   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="CreateCommitButton" Style="{StaticResource ScmIconButton}" Margin="5,0,0,0" IsEnabled="False" Click="CreateCommit_Click" ToolTip="Commit staged changes"><TextBlock Style="{StaticResource Codicon}" Text="&#xEAFC;"/></Button>
    <Button Style="{StaticResource ScmIconButton}" Click="Refresh_Click" ToolTip="Refresh source control"><TextBlock Style="{StaticResource Codicon}" Text="&#xEB37;"/></Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,8,0,4">
   <TreeView x:Name="ChangesTree" ItemsSource="{Binding ChangeGroups, ElementName=Root}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItemChanged="ChangesTree_SelectedItemChanged" MouseDoubleClick="ChangesTree_DoubleClick" PreviewMouseRightButtonDown="ChangesTree_RightClick"/>
   <Grid x:Name="CommitView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="4,0,4,8">
     <TextBlock x:Name="CommitDescription" Text="Select a commit from history." TextWrapping="Wrap" FontWeight="SemiBold"/>
     <TextBlock x:Name="CommitMetadata" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource ShellMutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <TreeView x:Name="CommitFilesTree" Grid.Row="1" ItemsSource="{Binding CommitChangeGroups, ElementName=Root}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItemChanged="CommitTree_SelectedItemChanged" MouseDoubleClick="CommitTree_DoubleClick"/>
   </Grid>
   <TextBlock x:Name="StateText" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" IsHitTestVisible="False"/>
  </Grid>
  <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource ShellBorderBrush}"/>
  <Grid Grid.Row="3" Margin="0,5,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="BranchPicker" MinHeight="34" MaxWidth="240" HorizontalAlignment="Stretch" Style="{StaticResource FlatBranchPicker}" SelectionChanged="BranchPicker_SelectionChanged"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
     <Button Style="{StaticResource ScmIconButton}" Click="Push_Click" ToolTip="Push"><TextBlock Style="{StaticResource Codicon}" Text="&#xEB41;"/></Button>
     <Button Style="{StaticResource ScmIconButton}" Click="ForcePush_Click" ToolTip="Force Push with Lease"><TextBlock Style="{StaticResource Codicon}" Text="&#xEB3F;"/></Button>
     <Button Style="{StaticResource ScmIconButton}" Click="Pull_Click" ToolTip="Pull"><TextBlock Style="{StaticResource Codicon}" Text="&#xEB40;"/></Button>
     <Button Style="{StaticResource ScmIconButton}" Click="Fetch_Click" ToolTip="Fetch All Remotes"><TextBlock Style="{StaticResource Codicon}" Text="&#xEAC2;"/></Button>
    </StackPanel>
   </Grid>
   <ListBox x:Name="HistoryList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Commits, ElementName=Root}" SelectionChanged="History_SelectionChanged" MouseDoubleClick="History_DoubleClick">
    <ListBox.ItemTemplate><DataTemplate><Grid Margin="2,4"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" FontSize="10" Foreground="{DynamicResource ShellMutedBrush}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Author}"/><Run Text=" · "/><Run Text="{Binding Date}"/></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
  <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="{DynamicResource ErrorForegroundBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
 </Grid>
</UserControl>
