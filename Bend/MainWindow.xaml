<Window x:Class="Bend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Bend"
        xmlns:controls="clr-namespace:Bend.Controls"
        xmlns:scm="clr-namespace:Bend.SourceControl"
        xmlns:term="clr-namespace:Console;assembly=Console"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        x:Name="ThisWindow"
        Title="Bend"
        Width="1200"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        FontFamily="Segoe UI"
        FontSize="12"
        Foreground="{DynamicResource ForegroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="/Bend;component/Images/Arrow-icon.png"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        SourceInitialized="Window_SourceInitialized"
        Drop="Window_Drop"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        AllowDrop="True">
    <Window.CommandBindings>
        <CommandBinding Command="Save"
                Executed="CommandSave"/>
        <CommandBinding Command="Open"
                Executed="CommandOpen"/>
        <CommandBinding Command="New"
                Executed="CommandNew"/>
        <CommandBinding Command="Refresh"
                Executed="CommandRefresh"/>
        <CommandBinding Command="Find"
                Executed="CommandFind"/>
        <CommandBinding Command="Replace"
                Executed="CommandReplace"/>
        <CommandBinding Command="GoToPage"
                Executed="CommandGoto"/>
        <CommandBinding Command="Help"
                Executed="CommandHelp"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="S"
                Modifiers="Control"
                Command="Save"/>
        <KeyBinding Key="O"
                Modifiers="Control"
                Command="Open"/>
        <KeyBinding Key="N"
                Modifiers="Control"
                Command="New"/>
        <KeyBinding Key="F"
                Modifiers="Control"
                Command="Find"/>
        <KeyBinding Key="H"
                Modifiers="Control"
                Command="Replace"/>
        <KeyBinding Key="G"
                Modifiers="Control"
                Command="GoToPage"/>
        <KeyBinding Key="F5"
                Command="Refresh"/>
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="PlainStyle"
                TargetType="{x:Type local:MainWindow}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:MainWindow}">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="ShellChromeBrush"
                Color="#EBEBEB"/>
        <SolidColorBrush x:Key="ShellPanelBrush"
                Color="#F1F1F1"/>
        <SolidColorBrush x:Key="ShellBorderBrush"
                Color="#D0D0D0"/>
        <SolidColorBrush x:Key="ShellMutedBrush"
                Color="#777777"/>
        <Style TargetType="Path">
            <Setter Property="MaxWidth"
                    Value="22"/>
            <Setter Property="MaxHeight"
                    Value="22"/>
            <Setter Property="StrokeThickness"
                    Value="1.5"/>
            <Setter Property="StrokeLineJoin"
                    Value="Round"/>
            <Setter Property="StrokeStartLineCap"
                    Value="Round"/>
            <Setter Property="StrokeEndLineCap"
                    Value="Round"/>
        </Style>
        <TextBlock x:Key="NewFileIcon" Width="18" Height="20" Text="&#xEA7F;" TextAlignment="Center" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock x:Key="OpenFileIcon" Width="18" Height="20" Text="&#xEA94;" TextAlignment="Center" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock x:Key="OpenFolderIcon" Width="18" Height="20" Text="&#xEAF7;" TextAlignment="Center" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock x:Key="RecentFilesIcon" Width="18" Height="20" Text="&#xEA82;" TextAlignment="Center" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ForegroundBrush}" RenderTransform="{DynamicResource RecentFilesIconOffset}"/>
        <TextBlock x:Key="SaveIcon" Width="18" Height="20" Text="&#xEB4B;" TextAlignment="Center" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock x:Key="SaveAsIcon" Width="18" Height="20" Text="&#xEB4A;" TextAlignment="Center" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock x:Key="EncodingIcon" Width="18" Height="20" Text="&#xEA7B;" TextAlignment="Center" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock x:Key="SettingsIcon" Width="18" Height="20" Text="&#xEB51;" TextAlignment="Center" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock x:Key="ExitIcon" Width="18" Height="20" Text="&#xEA6E;" TextAlignment="Center" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ForegroundBrush}"/>
        <TranslateTransform x:Key="RecentFilesIconOffset" X="2" />
        <Style x:Key="ChromeButton"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="S"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ShellBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="S"
                                        Property="Background"
                                        Value="{DynamicResource MenuSelectedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusSegment" TargetType="RadioButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource LogoForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="4,1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="#45FFFFFF"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="#28FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FileMenuItemStyle"
                TargetType="MenuItem">
            <Setter Property="FontFamily"
                    Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize"
                    Value="18"/>
            <Setter Property="FontWeight"
                    Value="Normal"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
        </Style>
        <ControlTemplate x:Key="FileMenuHeaderTemplate"
                TargetType="MenuItem">
            <Grid>
                <Border x:Name="HeaderBorder"
                        Background="Transparent"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"/>
                </Border>
                <Popup x:Name="PART_Popup"
                        AllowsTransparency="True"
                        Focusable="False"
                        IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=HeaderBorder}"
                        PopupAnimation="Fade">
                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource ShellBorderBrush}"
                            BorderThickness="1"
                            MinWidth="300"
                            Padding="0,5"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted"
                        Value="True">
                    <Setter TargetName="HeaderBorder"
                            Property="Background"
                            Value="{DynamicResource MenuSelectedBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen"
                        Value="True">
                    <Setter TargetName="HeaderBorder"
                            Property="Background"
                            Value="{DynamicResource MenuSelectedBackgroundBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ActivityButton"
                TargetType="Button"
                BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Width"
                    Value="48"/>
            <Setter Property="Height"
                    Value="58"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource ShellMutedBrush}"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>
        <ContextMenu x:Key="TabTitleContextMenu"
                x:Shared="true"
                MinWidth="210">
            <MenuItem Header="Refresh"
                    Click="ContextRefresh"
                    InputGestureText="F5"/>
            <MenuItem Header="Close"
                    Click="ContextClose"/>
            <MenuItem Header="Close other tabs"
                    Click="ContextCloseOtherTabs"/>
            <Separator/>
            <MenuItem Header="File encoding…"
                    Click="ContextFileEncoding"/>
            <MenuItem Header="Copy full path"
                    Click="ContextCopyFullPath"/>
            <MenuItem Header="Open containing folder"
                    Click="ContextOpenContainingFolder"/>
            <Separator/>
            <MenuItem Header="Reopen last session"
                    Click="ReopenLastSession"/>
        </ContextMenu>
        <ContextMenu x:Key="EditorContextMenu"
                x:Shared="true"
                MinWidth="210">
            <MenuItem Header="Cut"
                    Click="ContextCut"
                    InputGestureText="Ctrl+X"/>
            <MenuItem Header="Copy"
                    Click="ContextCopy"
                    InputGestureText="Ctrl+C"/>
            <MenuItem Header="Paste"
                    Click="ContextPaste"
                    InputGestureText="Ctrl+V"/>
            <Separator/>
            <MenuItem Header="Undo"
                    Click="ContextUndo"/>
            <MenuItem Header="Redo"
                    Click="ContextRedo"/>
            <Separator/>
            <MenuItem x:Name="GoToLine"
                    Header="Go to line…"
                    Click="ContextGoToLine"/>
            <MenuItem x:Name="Record"
                    Header="Record"
                    Click="ContextRecord"/>
        </ContextMenu>
        <Storyboard x:Key="slideSettingsIn">
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Settings"
                    Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0"
                        Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="slideSettingsOut">
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Settings"
                    Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0"
                        Value="{x:Static Visibility.Hidden}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="fileSave">
            <DoubleAnimation Storyboard.TargetName="Editor"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To=".35"
                    AutoReverse="True"
                    Duration="0:0:.25"/>
        </Storyboard>
    </Window.Resources>
    <Grid x:Name="ClientAreaGrid">
        <Grid x:Name="MainWindowGrid">
            <Grid.RenderTransform>
                <RotateTransform x:Name="MainWindowGridRotateTransform"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="31.4"/>
            </Grid.RowDefinitions>
            <Grid x:Name="WindowDrag"
                    Grid.Row="0"
                    Background="{DynamicResource ShellChromeBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="372"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Menu x:Name="Logo"
                        Background="Transparent"
                        Foreground="{DynamicResource ForegroundBrush}"
                        FontFamily="Segoe UI"
                        VerticalAlignment="Stretch">
                    <MenuItem Header="Bend"
                            Height="28"
                            VerticalContentAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Padding="7,0,7,0"
                            Click="BendMenu_Click"
                            Template="{StaticResource FileMenuHeaderTemplate}">
                        <MenuItem Header="New file"
                                Style="{StaticResource FileMenuItemStyle}"
                                Icon="{DynamicResource NewFileIcon}"
                                Command="New"
                                InputGestureText="Ctrl+N"/>
                        <MenuItem Header="Open file…"
                                Style="{StaticResource FileMenuItemStyle}"
                                Icon="{DynamicResource OpenFileIcon}"
                                Command="Open"
                                InputGestureText="Ctrl+O"/>
                        <MenuItem Header="Open folder…"
                                Style="{StaticResource FileMenuItemStyle}"
                                Icon="{DynamicResource OpenFolderIcon}"
                                Click="OpenFolder_Click"/>
                        <MenuItem Header="Recent files"
                                Style="{StaticResource FileMenuItemStyle}"
                                Icon="{DynamicResource RecentFilesIcon}">
                            <MenuItem Header="No recent files"
                                    Style="{StaticResource FileMenuItemStyle}"
                                    IsEnabled="False"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Save"
                                Style="{StaticResource FileMenuItemStyle}"
                                Icon="{DynamicResource SaveIcon}"
                                Command="Save"/>
                        <MenuItem Header="Save as…"
                                Style="{StaticResource FileMenuItemStyle}"
                                Icon="{DynamicResource SaveAsIcon}"
                                InputGestureText="Ctrl+Shift+S"
                                Click="SaveAsMenu_Click"/>
                        <MenuItem Header="Save with encoding…"
                                Style="{StaticResource FileMenuItemStyle}"
                                Icon="{DynamicResource EncodingIcon}"
                                Click="SaveEncodingMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="Settings"
                                Style="{StaticResource FileMenuItemStyle}"
                                Icon="{DynamicResource SettingsIcon}"
                                Click="SettingsMenu_Click"/>
                        <MenuItem Header="Exit"
                                Style="{StaticResource FileMenuItemStyle}"
                                Icon="{DynamicResource ExitIcon}"
                                Click="ExitMenu_Click"/>
                    </MenuItem>
                </Menu>
                <Border Grid.Column="0" Grid.ColumnSpan="5"
                        Width="372"
                        HorizontalAlignment="Center"
                        Height="32"
                        Margin="0,0,46,0"
                        VerticalAlignment="top"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ShellBorderBrush}"
                        Background="{DynamicResource BackgroundBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform X="0"
                                Y="9"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="15"
                                Height="15"
                                Stroke="{DynamicResource ShellMutedBrush}"
                                StrokeThickness="1.5"
                                Data="M11,6.5 A4.5,4.5 0 1 1 2,6.5 A4.5,4.5 0 1 1 11,6.5 M9.7,9.7 L14,14"/>
                        <TextBlock x:Name="SearchHint"
                                Grid.Column="1"
                                Text="Search"
                                Foreground="{DynamicResource ShellMutedBrush}"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                FontSize="14"/>
                        <TextBox x:Name="FindText"
                                Grid.Column="1"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="{DynamicResource ForegroundBrush}"
                                VerticalContentAlignment="Center"
                                TextChanged="FindText_TextChanged"
                                KeyDown="FindText_KeyDown"
                                FontSize="14"/>
                        <TextBlock Grid.Column="2"
                                Margin="10,0"
                                Text="Ctrl+F"
                                Foreground="{DynamicResource ShellMutedBrush}"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                FontSize="13"/>
                    </Grid>
                </Border>
                <Button x:Name="AgentButton" Grid.Column="0" Grid.ColumnSpan="5" Width="46" Height="32" Margin="372,9,0,0"
                        VerticalAlignment="Top" Style="{StaticResource ChromeButton}" Click="AgentButton_Click" ToolTip="Agent">
                    <TextBlock Text="&#xEC67;" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16"
                            Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <WrapPanel x:Name="WindowControls"
                        Grid.Column="4"
                        Height="28"
                        VerticalAlignment="Top">
                    <Button x:Name="FullscreenButton"
                            Visibility="Collapsed"/>
                    <Button x:Name="MinButton"
                            Width="46"
                            Height="28"
                            Style="{StaticResource ChromeButton}"
                            Click="MinimizeShell_Click">
                        <Border Width="12"
                                Height="12">
                            <Path VerticalAlignment="Center"
                                    Stroke="{DynamicResource ForegroundBrush}"
                                    StrokeThickness="1"
                                    Data="M0,6 L12,6"/>
                        </Border>
                    </Button>
                    <Button x:Name="MaxButton"
                            Width="46"
                            Height="28"
                            Style="{StaticResource ChromeButton}"
                            Click="MaximizeShell_Click">
                        <Rectangle Width="11"
                                Height="11"
                                Stroke="{DynamicResource ForegroundBrush}"
                                StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="QuitButton"
                            Width="46"
                            Height="28"
                            Style="{StaticResource ChromeButton}"
                            Click="CloseShell_Click">
                        <Path Width="11"
                                Height="11"
                                Stroke="{DynamicResource ForegroundBrush}"
                                StrokeThickness="1.3"
                                Data="M0,0 L11,11 M11,0 L0,11"/>
                    </Button>
                </WrapPanel>
            </Grid>
            <Border Grid.Row="0"
                    Height="0.67"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource ShellBorderBrush}"
                    Panel.ZIndex="2"/>
                        <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition x:Name="SidePaneColumn" Width="0"/>
                                        <ColumnDefinition Width="*" MinWidth="100"/>
                                        <ColumnDefinition x:Name="AgentSplitterColumn" Width="0"/>
                                        <ColumnDefinition x:Name="AgentPaneColumn" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <Grid Background="{DynamicResource ActivityBarBrush}">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                    <Border Grid.RowSpan="5"
                            Width="0.67"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource ShellBorderBrush}"
                            Panel.ZIndex="2"/>
                    <Button x:Name="FilesActivityButton"
                            Style="{StaticResource ActivityButton}"
                            Click="FilesActivity_Click"
                            ToolTip="Files">
                        <TextBlock Text="&#xEAF0;"
                                FontFamily="/Bend;component/Fonts/#codicon"
                                FontSize="24"
                                Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Row="1"
                            x:Name="SearchActivityButton"
                            Style="{StaticResource ActivityButton}"
                            Click="SearchActivity_Click"
                            ToolTip="Search">
                                                <TextBlock Text="&#xEA6D;"
                                                                FontFamily="/Bend;component/Fonts/#codicon"
                                                                FontSize="24"
                                                                Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Row="2"
                            x:Name="SourceControlActivityButton"
                            Style="{StaticResource ActivityButton}"
                            Click="SourceControlActivity_Click"
                            ToolTip="Source control">
                                                <TextBlock Text="&#xEA68;"
                                                                FontFamily="/Bend;component/Fonts/#codicon"
                                                                FontSize="24"
                                                                Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Row="4"
                            x:Name="SettingsActivityButton"
                            Style="{StaticResource ActivityButton}"
                            Click="SettingsActivity_Click"
                            ToolTip="Settings">
                        <Grid Width="19"
                                Height="19">
                            <Ellipse Width="5"
                                    Height="5"
                                    Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                    StrokeThickness="1.45"/>
                            <Path Stretch="Uniform"
                                    Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                    StrokeThickness="1.45"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    Data="M19.4,15 C19.1,15.6 19.2,16.3 19.7,16.9 L19.8,17 17,19.8 16.9,19.7 C16.4,19.2 15.6,19.1 15,19.4 14.4,19.7 14,20.3 14,21 L14,21.2 10,21.2 10,21 C10,20.3 9.6,19.7 9,19.4 8.4,19.1 7.6,19.2 7.1,19.7 L7,19.8 4.2,17 4.3,16.9 C4.8,16.4 4.9,15.6 4.6,15 4.3,14.4 3.7,14 3,14 L2.8,14 2.8,10 3,10 C3.7,10 4.3,9.6 4.6,9 4.9,8.4 4.8,7.6 4.3,7.1 L4.2,7 7,4.2 7.1,4.3 C7.6,4.8 8.4,4.9 9,4.6 9.6,4.3 10,3.7 10,3 L10,2.8 14,2.8 14,3 C14,3.7 14.4,4.3 15,4.6 15.6,4.9 16.4,4.8 16.9,4.3 L17,4.2 19.8,7 19.7,7.1 C19.2,7.6 19.1,8.4 19.4,9 19.7,9.6 20.3,10 21,10 L21.2,10 21.2,14 21,14 C20.3,14 19.7,14.4 19.4,15 Z"/>
                        </Grid>
                    </Button>
                </Grid>
                <Border Grid.Column="1"
                        Background="{DynamicResource ShellChromeBrush}"
                        BorderBrush="{DynamicResource ShellBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SidePaneTitle"
                                Margin="14,0"
                                VerticalAlignment="Center"
                                FontSize="11"/>
                        <controls:FilesPanel x:Name="FilesPanel"
                                Grid.RowSpan="2"
                                OpenFolderRequested="FilesPanel_OpenFolderRequested"
                                FileInvoked="FilesPanel_FileInvoked"
                                Visibility="Collapsed"/>
                        <controls:SearchPanel x:Name="SearchPanel"
                                Grid.RowSpan="2"
                                ResultInvoked="SearchPanel_ResultInvoked"
                                Visibility="Collapsed"/>
                        <scm:SourceControlPanel x:Name="SourceControlPanel" Grid.RowSpan="2" Visibility="Collapsed"
                                DiffRequested="SourceControlPanel_DiffRequested" DiffModeChanged="SourceControlPanel_DiffModeChanged"/>
                        <TextBlock x:Name="OtherSidePaneContent"
                                Grid.Row="1"
                                Margin="22"
                                VerticalAlignment="Center"
                                Text="This pane is intentionally empty in this release."
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource ShellMutedBrush}"/>
                    </Grid>
                </Border>
                <GridSplitter x:Name="SidePaneSplitter" Grid.Column="1"
                        Width="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        ResizeDirection="Columns"
                        ResizeBehavior="CurrentAndNext"
                        ShowsPreview="False"
                        DragCompleted="SidePaneSplitter_DragCompleted"
                        Panel.ZIndex="3"/>
                <Grid Grid.Column="2"
                        x:Name="MainDock">
                    <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="Editor"
                                                        Grid.Row="1"
                            ContextMenu="{StaticResource EditorContextMenu}"
                            Background="{DynamicResource BackgroundBrush}"/>
                    <Border x:Name="TabStrip"
                                                        Grid.Row="0"
                            Visibility="Visible"
                            VerticalAlignment="Top"
                            Height="35.7"
                            Background="{DynamicResource ShellChromeBrush}"
                            BorderBrush="{DynamicResource ShellBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <WrapPanel x:Name="TabBar"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Center"
                                    Margin="0"/>
                            <Button Width="42"
                                    Height="35.7"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ChromeButton}"
                                    Click="NewShell_Click">
                                <Path Width="14"
                                        Height="14"
                                        Stroke="{DynamicResource ShellMutedBrush}"
                                        Data="M7,0 L7,14 M0,7 L14,7"/>
                            </Button>
                        </DockPanel>
                    </Border>
                </Grid>
                <GridSplitter x:Name="AgentPaneSplitter" Grid.Column="3" Width="5" Margin="-2,0" HorizontalAlignment="Stretch"
                        Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                        DragCompleted="AgentPaneSplitter_DragCompleted" Visibility="Collapsed" Panel.ZIndex="3"/>
                <Border Grid.Column="3" Width="0.67" HorizontalAlignment="Center"
                        Background="{DynamicResource ShellBorderBrush}" IsHitTestVisible="False" Panel.ZIndex="2"/>
                <Grid x:Name="AgentPane" Grid.Column="4" Visibility="Collapsed" Background="{DynamicResource TerminalColorBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="35.7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="{DynamicResource ShellPanelBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="AgentTabBar" Orientation="Horizontal" Height="35.7"/>
                        </ScrollViewer>
                        <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Click="AgentNewTerminalMenu_Click" ToolTip="New agent terminal">
                            <Button.ContextMenu><ContextMenu x:Name="AgentCliMenu"/></Button.ContextMenu>
                            <TextBlock Text="&#xEAB4;" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ShellMutedBrush}"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Click="AgentClosePane_Click" ToolTip="Collapse right pane">
                            <TextBlock Text="&#xEC00;" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ShellMutedBrush}"/>
                        </Button>
                    </Grid>
                    <Grid x:Name="AgentTerminalHost" Grid.Row="1" Background="{DynamicResource TerminalColorBrush}"/>
                </Grid>
            </Grid>
                        <Grid x:Name="BottomChrome"
                                        Grid.Row="2"
                        Background="{DynamicResource ShellChromeBrush}">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="35.7"/>
                                        <RowDefinition Height="0"/>
                                        <RowDefinition Height="0"/>
                                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3"
                        Grid.RowSpan="3"
                        Height="1"
                        VerticalAlignment="Top"
                        Background="{DynamicResource ShellBorderBrush}"/>
                <Border Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource TerminalColorBrush}"/>
                <Grid Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="TerminalTabScrollViewer"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Height="35.7"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"
                            ScrollChanged="TerminalTabScrollViewer_ScrollChanged">
                        <StackPanel x:Name="TerminalTabBar"
                                Orientation="Horizontal"
                                Height="35.7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                    </ScrollViewer>
                    <Button x:Name="TerminalTabScrollLeft"
                            Grid.Column="1"
                            Style="{StaticResource ChromeButton}"
                            Click="TerminalTabScrollLeft_Click"
                            Visibility="Collapsed"
                            ToolTip="Scroll terminal tabs left">
                        <Path Width="8"
                                Height="8"
                                Stroke="{DynamicResource ShellMutedBrush}"
                                Data="M6,0 L2,4 L6,8"/>
                    </Button>
                    <Button x:Name="TerminalTabScrollRight"
                            Grid.Column="2"
                            Style="{StaticResource ChromeButton}"
                            Click="TerminalTabScrollRight_Click"
                            Visibility="Collapsed"
                            ToolTip="Scroll terminal tabs right">
                        <Path Width="8"
                                Height="8"
                                Stroke="{DynamicResource ShellMutedBrush}"
                                Data="M2,0 L6,4 L2,8"/>
                    </Button>
                </Grid>
                <Button x:Name="ToggleBottomPanel"
                        Grid.Row="0"
                        Width="150"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ChromeButton}"
                        Click="TerminalToggle_Click"
                        IsHitTestVisible="False"
                        Opacity="0"/>
                <StackPanel Grid.Column="2"
                        Grid.Row="0"
                                                HorizontalAlignment="Right"
                        Orientation="Horizontal">
                    <Button x:Name="SavedCommandsButton" Width="105"
                            Style="{StaticResource ChromeButton}"
                            Click="SavedCommands_Click"
                            ToolTip="Saved commands">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SavedCommandsMenu" Opened="SavedCommandsMenu_Opened"/>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xEA65;" Width="16" TextAlignment="Center" VerticalAlignment="Center" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16" Foreground="{DynamicResource ShellMutedBrush}"/>
                            <TextBlock Text="Macro" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource ShellMutedBrush}"/>
                            <Path Width="8" Height="5" VerticalAlignment="Center" Margin="7,0,0,0" Stroke="{DynamicResource ShellMutedBrush}" StrokeThickness="1" Data="M0,0 L4,4 L8,0"/>
                        </StackPanel>
                    </Button>
                    <Button Width="90"
                            Style="{StaticResource ChromeButton}"
                            Click="ShellSelector_Click"
                            ToolTip="Select shell">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="PowerShell"
                                        Click="PowerShellShell_Click"/>
                                <MenuItem Header="Command Prompt"
                                        Click="CommandPromptShell_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center">
                            <TextBlock x:Name="ShellLabel"
                                    Text="Pwsh"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="14"
                                    Foreground="{DynamicResource ShellMutedBrush}"/>
                            <Path Width="8"
                                    Height="5"
                                    VerticalAlignment="Center"
                                                                        Margin="6,0,0,0"
                                    Stroke="{DynamicResource ShellMutedBrush}"
                                    Data="M0,0 L4,5 L8,0"/>
                                                </StackPanel>
                    </Button>
                    <Button Width="47"
                            Style="{StaticResource ChromeButton}"
                            Click="NewTerminal_Click"
                            ToolTip="New terminal">
                        <Path Width="10"
                                Height="10"
                                Stroke="{DynamicResource ShellMutedBrush}"
                                Data="M5,0 L5,10 M0,5 L10,5"/>
                    </Button>
                    <Button Width="47"
                            Style="{StaticResource ChromeButton}"
                            Click="TerminalToggle_Click"
                            ToolTip="Expand terminal">
                        <Path Width="8"
                                Height="5"
                                Stroke="{DynamicResource ShellMutedBrush}"
                                x:Name="TerminalToggleChevron"
                                Data="M0,5 L4,1 L8,5"/>
                    </Button>
                </StackPanel>
                <primitives:Thumb x:Name="BottomPaneResizeThumb"
                        Grid.RowSpan="3"
                        Grid.ColumnSpan="3"
                        Height="5"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Opacity="0"
                        Cursor="SizeNS"
                        DragDelta="BottomPaneResizeThumb_DragDelta"
                        DragCompleted="BottomPaneResizeThumb_DragCompleted"
                        Visibility="Collapsed"
                        Panel.ZIndex="4"/>
                                <GridSplitter x:Name="MainDockSplitter"
                                                Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                                Height="4"
                                                Background="{DynamicResource TerminalColorBrush}"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed"/>
                                <Grid x:Name="MainDockBottomPanel"
                                                Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                                        Background="{DynamicResource TerminalColorBrush}"
                                                Visibility="Collapsed">
                                                <Border Background="{DynamicResource TerminalColorBrush}"
                                                Padding="5,0,0,0">
                                                <term:TerminalControl x:Name="Terminal"
                                                            StartupCommandLine="pwsh.exe -NoLogo"
                                                        Win32InputMode="True"
                                                        InputCapture="TabKey,DirectionKeys"/>
                                        </Border>
                                </Grid>
            </Grid>
            <Grid Grid.Row="3"
                    Background="{DynamicResource LogoBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                        Margin="15,0">
                    <Path Width="11"
                            Height="13"
                            Margin="0,0,7,0"
                            Stroke="{DynamicResource LogoForegroundBrush}"
                            StrokeThickness="1.4"
                            Data="M1,1 L7,1 L10,4 L10,12 L1,12 Z M7,1 L7,4 L10,4"/>
                    <TextBlock x:Name="WorkspacePathText"
                            FontSize="13"
                            Foreground="{DynamicResource LogoForegroundBrush}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <WrapPanel x:Name="StatusBar"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" ToolTip="Diff presentation">
                        <RadioButton x:Name="DiffNoneButton" GroupName="AppDiffMode" Style="{StaticResource StatusSegment}" ToolTip="Hide diff" Checked="DiffMode_Checked">
                            <TextBlock Text="&#xEADD;" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16"/>
                        </RadioButton>
                        <RadioButton x:Name="DiffInlineButton" GroupName="AppDiffMode" Style="{StaticResource StatusSegment}" Margin="-1,0,0,0" ToolTip="Inline diff" Checked="DiffMode_Checked">
                            <TextBlock Text="&#xEAE1;" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16"/>
                        </RadioButton>
                        <RadioButton x:Name="DiffSideBySideButton" GroupName="AppDiffMode" Style="{StaticResource StatusSegment}" Margin="-1,0,0,0" ToolTip="Side-by-side diff" Checked="DiffMode_Checked">
                            <TextBlock Text="&#xEB56;" FontFamily="/Bend;component/Fonts/#codicon" FontSize="16"/>
                        </RadioButton>
                    </StackPanel>
                    <TextBlock Text="Ln"
                            FontSize="13"
                            Foreground="{DynamicResource LogoForegroundBrush}"
                            VerticalAlignment="Center"/>
                    <Label x:Name="Line"
                            FontSize="13"
                            Foreground="{DynamicResource LogoForegroundBrush}"
                            Padding="4,0,0,0"
                            Width="38"
                            HorizontalContentAlignment="Right"
                            Content="0"
                            VerticalContentAlignment="Center"/>
                    <TextBlock Text=", Col"
                            FontSize="13"
                            Foreground="{DynamicResource LogoForegroundBrush}"
                            VerticalAlignment="Center"/>
                    <Label x:Name="Column"
                            FontSize="13"
                            Foreground="{DynamicResource LogoForegroundBrush}"
                            Padding="4,0,0,0"
                            Width="38"
                            HorizontalContentAlignment="Right"
                            Content="0"
                            VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="DocumentTypeStatus"
                            Text="UTF-8    Plain Text"
                            FontSize="13"
                            Foreground="{DynamicResource LogoForegroundBrush}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"/>
                </WrapPanel>
                <Label x:Name="StatusText"
                        Grid.ColumnSpan="2"
                        Visibility="Hidden"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Foreground="{DynamicResource LogoForegroundBrush}"
                        Padding="8,0"/>
            </Grid>
        <Grid x:Name="Settings"
                Grid.RowSpan="4"
                Visibility="Hidden"
                Background="{DynamicResource EditorSurfaceBrush}"
                Panel.ZIndex="10">
            <Grid.RenderTransform>
                <RotateTransform x:Name="SettingsGridRotateTransform"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="49.33"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="2" Background="{DynamicResource ShellChromeBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Menu x:Name="SettingsLogo"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        Foreground="{DynamicResource ForegroundBrush}"
                        FontFamily="Segoe UI"
                        VerticalAlignment="Stretch">
                    <MenuItem x:Name="SettingsLogoMenuItem"
                            Header="Bend"
                            Height="49.33"
                            VerticalContentAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            FontFamily="Segoe UI Variable Display"
                            Padding="22,0"
                            ToolTip="Back to editor"
                            Click="SettingsBack_Click"
                            Template="{StaticResource FileMenuHeaderTemplate}"/>
                </Menu>
                <Button x:Name="BackButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Margin="0,0,34,0"
                        Style="{StaticResource ChromeButton}"
                        Padding="16,0"
                        ToolTip="Back to editor"
                        Click="SettingsBack_Click">
                    <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                        <TextBlock Text="&#xEA9B;"
                                FontFamily="/Bend;component/Fonts/#codicon"
                                FontSize="24"
                                Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                </Button>
                        </Grid>
                        <local:Settings x:Name="SettingsControl" Grid.Row="1" Grid.ColumnSpan="2" />
                                <TextBlock x:Name="SettingsWorkspacePathText" Grid.Row="2" Grid.ColumnSpan="2" Margin="12,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource LogoForegroundBrush}" Text="{Binding Text, ElementName=WorkspacePathText}"/>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Settings" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource LogoForegroundBrush}"/>
            </Grid>
        </Grid>
        <Border BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="1"
                Panel.ZIndex="100"
                IsHitTestVisible="False"/>
        <Canvas x:Name="ResizeCrimp"
                Visibility="Collapsed"/>
    </Grid>
</Window>
