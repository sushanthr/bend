<UserControl x:Class="Bend.Settings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Initialized="ControlInitialized" IsVisibleChanged="Settings_IsVisibleChanged" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI" FontSize="12">
 <UserControl.Resources>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,26,0,7"/></Style>
  <Style x:Key="SettingRow" TargetType="Border"><Setter Property="MinHeight" Value="44"/><Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/></Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}"/><Setter Property="FontSize" Value="10"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="12,3"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="FontSize" Value="11"/></Style>
  <Style x:Key="SettingsTab" TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="Padding" Value="16,0,16,12"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Grid Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/><Border x:Name="SelectedLine" Height="3" VerticalAlignment="Bottom" Background="{DynamicResource LogoBackgroundBrush}" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectedLine" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PageScroller" TargetType="ScrollViewer"><Setter Property="Margin" Value="52,0,52,0"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="52,36,52,0"><TextBlock Text="SETTINGS" FontSize="10" Foreground="{DynamicResource ShellMutedBrush}"/><TextBlock Text="Preferences" Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold"/></StackPanel>
  <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="52,0,52,0" Background="Transparent" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0" SelectionChanged="TabControl_SelectionChanged">
   <TabItem Header="Editor" Style="{StaticResource SettingsTab}">
    <ScrollViewer Style="{StaticResource PageScroller}" Margin="0"><StackPanel Width="720" HorizontalAlignment="Left" Margin="0,24,0,30">
     <TextBlock Text="Editor" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Font family" VerticalAlignment="Center"/><ComboBox x:Name="FontPicker" Width="220" Height="28" HorizontalAlignment="Right" ItemsSource="{Binding Source={x:Static Member=Fonts.SystemFontFamilies}}"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Indent width" VerticalAlignment="Center"/><TextBox x:Name="TextIndent" Width="220" Height="28" Padding="8,3" HorizontalAlignment="Right" PreviewKeyDown="AllowOnlyDigits_PreviewKeyDown"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" MinHeight="64"><Grid><TextBlock Text="Indent with" Margin="0,11,0,0" VerticalAlignment="Top"/><StackPanel HorizontalAlignment="Right" Margin="0,8,0,0"><RadioButton x:Name="TextUseSpaces" GroupName="TextIndent" Content="Spaces"/><RadioButton x:Name="TextUseTabs" GroupName="TextIndent" Content="Tabs"/></StackPanel></Grid></Border>
     <Border Style="{StaticResource SettingRow}" MinHeight="49"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Word wrap"/><TextBlock Text="Wrap long lines to the editor width." Style="{StaticResource SecondaryText}"/></StackPanel><CheckBox x:Name="TextWordWrap"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Show formatting" VerticalAlignment="Center"/><CheckBox x:Name="TextFormatShowFormatting"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Preserve indent" VerticalAlignment="Center"/><CheckBox x:Name="PreserveIndent"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0,1,0,1"><Grid><TextBlock Text="Syntax highlighting" VerticalAlignment="Center"/><CheckBox x:Name="SyntaxHighlighting"/></Grid></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Application" Style="{StaticResource SettingsTab}">
    <ScrollViewer Style="{StaticResource PageScroller}" Margin="0"><StackPanel Width="720" HorizontalAlignment="Left" Margin="0,24,0,30">
     <TextBlock Text="Application" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Color theme" VerticalAlignment="Center"/><ComboBox x:Name="ThemePicker" Width="220" Height="28" HorizontalAlignment="Right" SelectionChanged="ThemePicker_SelectionChanged"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" MinHeight="49"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Status bar"/><TextBlock Text="Show position, encoding, and language." Style="{StaticResource SecondaryText}"/></StackPanel><CheckBox x:Name="ShowStatusBar"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Smooth scrolling" VerticalAlignment="Center"/><CheckBox x:Name="SmoothScrolling"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Reopen files on start" VerticalAlignment="Center"/><CheckBox x:Name="ReopenFilesOnStart"/></Grid></Border>
     <TextBlock Text="Agent" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource SettingRow}" MinHeight="58"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Default agent CLI"/><TextBlock Text="Command launched when the Agent pane opens." Style="{StaticResource SecondaryText}"/></StackPanel><TextBox x:Name="DefaultAgentCli" Width="220" Height="28" Padding="8,3" HorizontalAlignment="Right" VerticalContentAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" MinHeight="68"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Additional agent CLIs"/><TextBlock Text="Semicolon-separated commands shown in the Agent terminal menu." Style="{StaticResource SecondaryText}"/></StackPanel><TextBox x:Name="AdditionalAgentClis" Width="220" Height="28" Padding="8,3" HorizontalAlignment="Right" VerticalContentAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Settings page animation" VerticalAlignment="Center"/><CheckBox x:Name="SettingsPageAnimation"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0,1,0,1"><Grid><TextBlock Text="Diagnostics" VerticalAlignment="Center"/><CheckBox x:Name="Diagnostics"/></Grid></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="System" Style="{StaticResource SettingsTab}">
    <ScrollViewer Style="{StaticResource PageScroller}" Margin="0"><StackPanel Width="720" HorizontalAlignment="Left" Margin="0,24,0,30">
     <TextBlock Text="Windows integration" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
     <Border Style="{StaticResource SettingRow}" MinHeight="58"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Explorer context menu"/><TextBlock Text="Open files in Bend from Windows Explorer." Style="{StaticResource SecondaryText}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="EnableContextMenuButton" Content="Enable context menu" Click="EnableContextMenu_Click"/><Button x:Name="DisableContextMenuButton" Content="Disable context menu" Click="DisableContextMenu"/></StackPanel></Grid></Border>
     <Border Style="{StaticResource SettingRow}" MinHeight="58"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Command line"/><TextBlock Text="Launch Bend from a terminal using your user PATH." Style="{StaticResource SecondaryText}"/></StackPanel><Button x:Name="AppendToPathButton" Content="Append Bend to PATH" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AppendToPath_Click"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" MinHeight="76" BorderThickness="0,1,0,1"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Updates"/><TextBlock Text="Check whether a newer version of Bend is available." Style="{StaticResource SecondaryText}"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><Border Height="4" Width="125" HorizontalAlignment="Right" Margin="0,0,7,6" Background="{DynamicResource ShellBorderBrush}"><Path Fill="{DynamicResource LogoBackgroundBrush}"><Path.Data><RectangleGeometry x:Name="ProgressBar" Rect="0,0,0,4"/></Path.Data></Path></Border><Button x:Name="CheckForUpdatesButton" Width="125" Content="Check for updates" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CheckForUpdates_Click"/></StackPanel></Grid></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="About &amp; shortcuts" Style="{StaticResource SettingsTab}">
    <ScrollViewer Style="{StaticResource PageScroller}" Margin="0"><StackPanel Width="720" HorizontalAlignment="Left" Margin="0,24,0,30">
     <TextBlock Text="About Bend" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/><TextBlock Text="Bend" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="A modern text editor" Foreground="{DynamicResource ShellMutedBrush}" Margin="0,3,0,0"/><TextBlock x:Name="Version" Foreground="{DynamicResource ShellMutedBrush}" Margin="0,2,0,0"/>
     <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock LineHeight="25" Text="F1&#x0a;F5&#x0a;Ctrl+0&#x0a;Ctrl+F&#x0a;Ctrl+G&#x0a;Ctrl+H&#x0a;Ctrl+N&#x0a;Ctrl+O&#x0a;Ctrl+S"/><TextBlock Grid.Column="1" LineHeight="25" Text="Open or close Settings&#x0a;Reload file&#x0a;Reset zoom&#x0a;Find in document&#x0a;Go to line&#x0a;Find and replace&#x0a;New file&#x0a;Open file&#x0a;Save file"/></Grid>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
